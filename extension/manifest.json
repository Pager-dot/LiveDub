{
  "manifest_version": 3,
  "name": "LiveDub",
  "version": "1.0.0",
  "description": "Live English captions and voiceover for any tab: YouTube, Meet, Zoom, Teams.",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab"],
  "host_permissions": ["http://localhost:3000/*", "https://*.ondigitalocean.app/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "LiveDub: click to start or stop dubbing this tab" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+D" } }
  },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }]
}
